@page "/"
@using DotNetQuest.App.Client.Components
@inject GameState Game
@inject I18nService I18n
@inject NavigationManager Nav
@implements IDisposable

<div class="landing">
    <div class="lang-float">
        <button class="lang-toggle" @onclick="ToggleLanguage">@(I18n.Language == "es" ? "🇪🇸 ES" : "🇬🇧 EN")</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(AuthError))
{
    <div class="auth-error-banner">⚠️ @AuthError</div>
}

<div class="landing-hero">
        <div class="landing-mascot">
            <BitMascot Pose="@BitPoses.Wave" Size="180" />
        </div>
        <h1 class="landing-title">DevQuest</h1>
        <p class="landing-tagline">@I18n.T("landing.tagline")</p>

        <div class="landing-actions">
            @if (Game.GoogleConfigured)
            {
                <a class="btn-google" href="/login-google?returnUrl=/">
                    <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.7-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-8l-6.5 5C9.6 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C36.9 39.2 44 34 44 24c0-1.3-.1-2.7-.4-3.9z"/></svg>
                    <span>@I18n.T("landing.google")</span>
                </a>
            }
            else
            {
                <div class="setup-card">
                    <p class="setup-title">⚙️ @I18n.T("landing.setupTitle")</p>
                    <p class="setup-text">@I18n.T("landing.setupText")</p>
                    <button class="btn btn-primary" @onclick="DevLogin">@I18n.T("landing.devLogin")</button>
                </div>
            }
        </div>

        <div class="landing-features">
            <div class="feature"><span>🤖</span><p>@I18n.T("landing.feature1")</p></div>
            <div class="feature"><span>⚡</span><p>@I18n.T("landing.feature2")</p></div>
            <div class="feature"><span>🗺️</span><p>@I18n.T("landing.feature3")</p></div>
            <div class="feature"><span>🗣️</span><p>@I18n.T("landing.feature4")</p></div>
        </div>
    </div>
</div>

@code {
    private bool _busy;

    [SupplyParameterFromQuery(Name = "authError")]
    public string? AuthError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Game.InitializeAsync();
        if (Game.Player is { OnboardingComplete: true })
            Nav.NavigateTo("home");
        else if (Game.Player is not null)
            Nav.NavigateTo("onboarding");  // signed in, first visit: set up the player
    }

    private async Task ToggleLanguage()
    {
        await I18n.SetLanguageAsync(I18n.Language == "en" ? "es" : "en");
    }

    private async Task DevLogin()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            if (await Game.DevLoginAsync())
                Nav.NavigateTo("onboarding");
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        // GameState is scoped per circuit; no cleanup needed here.
    }
}
